# Copy this file to `.env` and adjust values to suit your setup.
#
#   cp .env.example .env
#
# `.env` is gitignored — your edits stay local.

# ─── Media paths ────────────────────────────────────────────────────
# Where this stack stores downloads and media. The default (./data)
# keeps everything inside the prowlarr-stack directory — convenient
# for testing. Point this at your real library root for production:
#
#   MEDIA_ROOT=/mnt/media
#
# The stack creates these subdirectories on first run:
#
#   ${MEDIA_ROOT}/media/           ← finished library (add to Media Centarr watch_dirs)
#     Movies/
#     TV/
#   ${MEDIA_ROOT}/downloads/       ← qBittorrent save paths
#     complete/
#     incomplete/
#
MEDIA_ROOT=./data

# ─── User / group IDs ───────────────────────────────────────────────
# Container processes run as this user. Match your host user
# (run `id -u` and `id -g`) so permissions on the MEDIA_ROOT tree
# work without sudo. 1000 is the default for the first user on
# most distros.
PUID=1000
PGID=1000

# ─── Timezone ───────────────────────────────────────────────────────
# Used by all three containers for logs. Any valid tz database name.
#
#   TZ=Europe/Amsterdam
#   TZ=America/Chicago
#
TZ=UTC

# ─── Ports (host-facing) ────────────────────────────────────────────
# Override these if they conflict with something already on your host.
# The BitTorrent port (QBIT_BT_PORT) is your seed/leech port — if
# you're behind NAT and want incoming connections, forward this port.
PROWLARR_PORT=9696
QBIT_PORT=8080
FLARESOLVERR_PORT=8191
QBIT_BT_PORT=6881
