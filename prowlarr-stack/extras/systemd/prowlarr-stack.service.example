# Example systemd user unit — runs prowlarr-stack at login.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   sed "s|%PROWLARR_STACK_DIR%|$HOME/prowlarr-stack|g" \
#     extras/systemd/prowlarr-stack.service.example \
#     > ~/.config/systemd/user/prowlarr-stack.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now prowlarr-stack
#
# Uninstall:
#   systemctl --user disable --now prowlarr-stack
#   rm ~/.config/systemd/user/prowlarr-stack.service
#
# Adjust %PROWLARR_STACK_DIR% to wherever you keep this stack.

[Unit]
Description=Prowlarr stack (Prowlarr + qBittorrent + FlareSolverr)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%PROWLARR_STACK_DIR%
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=default.target
